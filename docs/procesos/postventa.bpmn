<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Posventa" targetNamespace="https://ruesma.es/procesos/posventa" exporter="generar_bpmn.py" exporterVersion="1">
  <bpmn:documentation>Ciclo de posventa de Construcciones Ruesma, desde que llega el listado de incidencias hasta que la incidencia se cierra en Sigrid. Sacado del código de postventa-incidencias (rama dev, 2026-10-20) y de su backlog. Colores: sin color, funciona hoy; ámbar, en curso; azul, previsto.</bpmn:documentation>
  <bpmn:error id="Error_Plantilla" name="No se puede generar la plantilla" errorCode="plantilla" />
  <bpmn:error id="Error_NoPlantilla" name="El fichero no es la plantilla" errorCode="400" />
  <bpmn:error id="Error_Archivo" name="No se archiva" errorCode="archivo" />
  <bpmn:collaboration id="Collaboration_Posventa">
    <bpmn:participant id="P_Propiedad" name="Propiedad o cliente" />
    <bpmn:participant id="P_Ruesma" name="Posventa de Construcciones Ruesma" processRef="Process_Posventa" />
    <bpmn:participant id="P_Sigrid" name="Sigrid (ERP), a través de sigrid-api" />
    <bpmn:participant id="P_SharePoint" name="SharePoint: biblioteca de Posventa" />
    <bpmn:participant id="P_Industrial" name="Industrial (proveedor que repara)" />
    <bpmn:messageFlow id="MF_Excel" name="Excel de incidencias" sourceRef="P_Propiedad" targetRef="Start_Listado" />
    <bpmn:messageFlow id="MF_Web" name="Incidencia web" sourceRef="P_Propiedad" targetRef="Start_Web" />
    <bpmn:messageFlow id="MF_Catalogo" name="Lee el catálogo de la obra" sourceRef="SP_Entrada" targetRef="P_Sigrid" />
    <bpmn:messageFlow id="MF_Relee" name="Relee el catálogo al aprobar" sourceRef="SP_Revision" targetRef="P_Sigrid" />
    <bpmn:messageFlow id="MF_Crea" name="Crea los partes en SAT (ref. PVI-)" sourceRef="SP_Volcado" targetRef="P_Sigrid" />
    <bpmn:messageFlow id="MF_PTE" name="Pasa a PTE" sourceRef="T_PTE" targetRef="P_Sigrid" />
    <bpmn:messageFlow id="MF_Aviso" name="Aviso al industrial" sourceRef="P_Sigrid" targetRef="P_Industrial" />
    <bpmn:messageFlow id="MF_Firmados" name="Partes firmados (papel escaneado)" sourceRef="P_Industrial" targetRef="Catch_Remesa" />
    <bpmn:messageFlow id="MF_Archiva" name="Archiva el PDF firmado" sourceRef="SP_Partes" targetRef="P_SharePoint" />
    <bpmn:messageFlow id="MF_Cierra" name="Adjunta el parte y cierra (CER)" sourceRef="SP_Partes" targetRef="P_Sigrid" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Posventa" name="Ciclo de posventa" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Posventa">
      <bpmn:lane id="L_Posventa" name="Persona de Posventa"><bpmn:flowNodeRef>Start_Listado</bpmn:flowNodeRef><bpmn:flowNodeRef>SP_Entrada</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Bandeja</bpmn:flowNodeRef><bpmn:flowNodeRef>SP_Revision</bpmn:flowNodeRef><bpmn:flowNodeRef>SP_Volcado</bpmn:flowNodeRef><bpmn:flowNodeRef>T_PTE</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Imprimir</bpmn:flowNodeRef><bpmn:flowNodeRef>Catch_Remesa</bpmn:flowNodeRef><bpmn:flowNodeRef>SP_Partes</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Coste</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Cerrada</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Portal" name="Portal de posventa (front y postventa-api)"><bpmn:flowNodeRef>Start_Web</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Listado" name="Llega el listado de incidencias de la propiedad (Excel)">
      <bpmn:outgoing>F_Listado_Entrada</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Listado_Msg" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Web" name="Llega una incidencia por la web de clientes (previsto, F-037)">
      <bpmn:outgoing>F_Web_Bandeja</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Web_Msg" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_Bandeja" name="">
      <bpmn:incoming>F_Entrada_Bandeja</bpmn:incoming>
      <bpmn:incoming>F_Web_Bandeja</bpmn:incoming>
      <bpmn:outgoing>F_Bandeja_Revision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_PTE" name="04 · Pasar el parte a PTE en Sigrid (a mano)">
      <bpmn:incoming>F_Volcado_PTE</bpmn:incoming>
      <bpmn:outgoing>F_PTE_Imprimir</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Imprimir" name="Imprimir los partes para la visita (previsto, F-044)">
      <bpmn:incoming>F_PTE_Imprimir</bpmn:incoming>
      <bpmn:outgoing>F_Imprimir_Remesa</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_Remesa" name="Llegan los partes firmados y escaneados">
      <bpmn:incoming>F_Imprimir_Remesa</bpmn:incoming>
      <bpmn:outgoing>F_Remesa_Partes</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Remesa_Msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_Coste" name="07 · Coste y venta de la posventa (previsto, F-046 y F-047)">
      <bpmn:incoming>F_Partes_Coste</bpmn:incoming>
      <bpmn:outgoing>F_Coste_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Cerrada" name="Incidencia cerrada en Sigrid (CER)">
      <bpmn:incoming>F_Coste_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_Bandeja" name="Bandeja de incidencias (PostgreSQL, esquema postventa)" />
    <bpmn:sequenceFlow id="F_Listado_Entrada" sourceRef="Start_Listado" targetRef="SP_Entrada" />
    <bpmn:sequenceFlow id="F_Entrada_Bandeja" sourceRef="SP_Entrada" targetRef="G_Bandeja" />
    <bpmn:sequenceFlow id="F_Web_Bandeja" sourceRef="Start_Web" targetRef="G_Bandeja" />
    <bpmn:sequenceFlow id="F_Bandeja_Revision" sourceRef="G_Bandeja" targetRef="SP_Revision" />
    <bpmn:sequenceFlow id="F_Revision_Volcado" name="Aprobadas" sourceRef="SP_Revision" targetRef="SP_Volcado" />
    <bpmn:sequenceFlow id="F_Volcado_PTE" name="Partes en SAT" sourceRef="SP_Volcado" targetRef="T_PTE" />
    <bpmn:sequenceFlow id="F_PTE_Imprimir" sourceRef="T_PTE" targetRef="T_Imprimir" />
    <bpmn:sequenceFlow id="F_Imprimir_Remesa" sourceRef="T_Imprimir" targetRef="Catch_Remesa" />
    <bpmn:sequenceFlow id="F_Remesa_Partes" sourceRef="Catch_Remesa" targetRef="SP_Partes" />
    <bpmn:sequenceFlow id="F_Partes_Coste" sourceRef="SP_Partes" targetRef="T_Coste" />
    <bpmn:sequenceFlow id="F_Coste_End" sourceRef="T_Coste" targetRef="End_Cerrada" />
    <bpmn:textAnnotation id="N_Revision"><bpmn:text>En curso: el backend está desplegado (F-056); la página bandeja.html es F-038. Previsto: ver también lo que ya hay en Sigrid y los conflictos (F-064).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_Volcado"><bpmn:text>El backend está desplegado (F-059) y probado en la 0626; el panel es F-040.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_Gestion"><bpmn:text>Previsto en la gestión: ficha de la incidencia (F-041), No procede con correo (F-042), operaciones en bloque (F-043) y editar o anular las ya volcadas (F-062).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_Entrada"><bpmn:text>Previsto: código de obra con cero delante (F-063), ubicaciones por unidad en la plantilla (F-058) y una tabla mejor en importar.html (F-057).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_Partes"><bpmn:text>Previsto: partes sin firma → TER (F-045) y remesas desde un buzón (F-011).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_N_Revision" associationDirection="None" sourceRef="N_Revision" targetRef="SP_Revision" />
    <bpmn:association id="A_N_Volcado" associationDirection="None" sourceRef="N_Volcado" targetRef="SP_Volcado" />
    <bpmn:association id="A_N_Gestion" associationDirection="None" sourceRef="N_Gestion" targetRef="T_PTE" />
    <bpmn:association id="A_N_Entrada" associationDirection="None" sourceRef="N_Entrada" targetRef="SP_Entrada" />
    <bpmn:association id="A_N_Partes" associationDirection="None" sourceRef="N_Partes" targetRef="SP_Partes" />
    <bpmn:subProcess id="SP_Entrada" name="01 · Entrada: importar el Excel a la bandeja">
      <bpmn:incoming>F_Listado_Entrada</bpmn:incoming>
      <bpmn:outgoing>F_Entrada_Bandeja</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_Entrada"><bpmn:targetRef>DS_Bandeja</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:startEvent id="E_Start" name="Llega el Excel de la propiedad (o hay que preparar la plantilla)">
        <bpmn:outgoing>E_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="E_GOficios" name="¿Hay oficios casi iguales por decidir?">
        <bpmn:incoming>E_F1</bpmn:incoming>
        <bpmn:outgoing>E_F2</bpmn:outgoing>
        <bpmn:outgoing>E_F3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="E_Oficios" name="Decidir oficios repetidos: mismo o distinto (oficios.html)">
        <bpmn:incoming>E_F2</bpmn:incoming>
        <bpmn:outgoing>E_F4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="E_MOficios" name="">
        <bpmn:incoming>E_F3</bpmn:incoming>
        <bpmn:incoming>E_F4</bpmn:incoming>
        <bpmn:outgoing>E_F5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="E_Plantilla" name="Elegir la obra y descargar la plantilla">
        <bpmn:incoming>E_F5</bpmn:incoming>
        <bpmn:outgoing>E_F6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="E_Generar" name="Generar la plantilla con el catálogo de Sigrid de hoy">
        <bpmn:incoming>E_F6</bpmn:incoming>
        <bpmn:outgoing>E_F7</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="E_GPlantilla" name="¿Se ha podido generar?">
        <bpmn:incoming>E_F7</bpmn:incoming>
        <bpmn:outgoing>E_F8</bpmn:outgoing>
        <bpmn:outgoing>E_F9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E_EndPlantilla" name="Obra no válida, sin unidades o Sigrid no responde">
        <bpmn:incoming>E_F8</bpmn:incoming>
        <bpmn:errorEventDefinition id="E_EndPlantilla_Err" errorRef="Error_Plantilla" />
      </bpmn:endEvent>
      <bpmn:manualTask id="E_Rellenar" name="La propiedad rellena el Excel (fuera del sistema)">
        <bpmn:incoming>E_F9</bpmn:incoming>
        <bpmn:outgoing>E_F10</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:exclusiveGateway id="E_MImportar" name="">
        <bpmn:incoming>E_F10</bpmn:incoming>
        <bpmn:incoming>E_F20</bpmn:incoming>
        <bpmn:outgoing>E_F11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="E_Importar" name="Importar el Excel a la bandeja">
        <bpmn:incoming>E_F11</bpmn:incoming>
        <bpmn:outgoing>E_F12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="E_Comprobar" name="Comprobar la huella, que sea la plantilla y cada fila">
        <bpmn:incoming>E_F12</bpmn:incoming>
        <bpmn:outgoing>E_F13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="E_GYa" name="¿Qué ha pasado?">
        <bpmn:incoming>E_F13</bpmn:incoming>
        <bpmn:outgoing>E_F14</bpmn:outgoing>
        <bpmn:outgoing>E_F15</bpmn:outgoing>
        <bpmn:outgoing>E_F16</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="E_EndYa" name="Ya importado: enseña el resumen original">
        <bpmn:incoming>E_F14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="E_EndNoPlantilla" name="No es la plantilla o pasa de 2 MiB: se rechaza entero">
        <bpmn:incoming>E_F15</bpmn:incoming>
        <bpmn:errorEventDefinition id="E_EndNoPlantilla_Err" errorRef="Error_NoPlantilla" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="E_Registrar" name="Registrar filas: nuevas, duplicadas en el fichero, ya en la bandeja">
        <bpmn:incoming>E_F16</bpmn:incoming>
        <bpmn:outgoing>E_F17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="E_Normalizar" name="Poner las ubicaciones en el texto exacto de Sigrid (F-060)">
        <bpmn:incoming>E_F17</bpmn:incoming>
        <bpmn:outgoing>E_F18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="E_GErrores" name="¿Filas con error?">
        <bpmn:incoming>E_F18</bpmn:incoming>
        <bpmn:outgoing>E_F19</bpmn:outgoing>
        <bpmn:outgoing>E_F21</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="E_Errores" name="Descargar el Excel de errores y corregirlo">
        <bpmn:incoming>E_F19</bpmn:incoming>
        <bpmn:outgoing>E_F20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="E_Ver" name="Ver la bandeja de la obra (solo lectura)">
        <bpmn:incoming>E_F21</bpmn:incoming>
        <bpmn:outgoing>E_F22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="E_End" name="Incidencias en la bandeja">
        <bpmn:incoming>E_F22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="E_F1" sourceRef="E_Start" targetRef="E_GOficios" />
      <bpmn:sequenceFlow id="E_F2" name="Sí" sourceRef="E_GOficios" targetRef="E_Oficios" />
      <bpmn:sequenceFlow id="E_F3" name="No" sourceRef="E_GOficios" targetRef="E_MOficios" />
      <bpmn:sequenceFlow id="E_F4" sourceRef="E_Oficios" targetRef="E_MOficios" />
      <bpmn:sequenceFlow id="E_F5" sourceRef="E_MOficios" targetRef="E_Plantilla" />
      <bpmn:sequenceFlow id="E_F6" sourceRef="E_Plantilla" targetRef="E_Generar" />
      <bpmn:sequenceFlow id="E_F7" sourceRef="E_Generar" targetRef="E_GPlantilla" />
      <bpmn:sequenceFlow id="E_F8" name="No" sourceRef="E_GPlantilla" targetRef="E_EndPlantilla" />
      <bpmn:sequenceFlow id="E_F9" name="Sí" sourceRef="E_GPlantilla" targetRef="E_Rellenar" />
      <bpmn:sequenceFlow id="E_F10" sourceRef="E_Rellenar" targetRef="E_MImportar" />
      <bpmn:sequenceFlow id="E_F11" sourceRef="E_MImportar" targetRef="E_Importar" />
      <bpmn:sequenceFlow id="E_F12" sourceRef="E_Importar" targetRef="E_Comprobar" />
      <bpmn:sequenceFlow id="E_F13" sourceRef="E_Comprobar" targetRef="E_GYa" />
      <bpmn:sequenceFlow id="E_F14" name="Mismo fichero ya importado" sourceRef="E_GYa" targetRef="E_EndYa" />
      <bpmn:sequenceFlow id="E_F15" name="No es la plantilla" sourceRef="E_GYa" targetRef="E_EndNoPlantilla" />
      <bpmn:sequenceFlow id="E_F16" name="Nuevo" sourceRef="E_GYa" targetRef="E_Registrar" />
      <bpmn:sequenceFlow id="E_F17" sourceRef="E_Registrar" targetRef="E_Normalizar" />
      <bpmn:sequenceFlow id="E_F18" sourceRef="E_Normalizar" targetRef="E_GErrores" />
      <bpmn:sequenceFlow id="E_F19" name="Sí" sourceRef="E_GErrores" targetRef="E_Errores" />
      <bpmn:sequenceFlow id="E_F20" name="Reimporta: lo que entró no se duplica" sourceRef="E_Errores" targetRef="E_MImportar" />
      <bpmn:sequenceFlow id="E_F21" name="No" sourceRef="E_GErrores" targetRef="E_Ver" />
      <bpmn:sequenceFlow id="E_F22" sourceRef="E_Ver" targetRef="E_End" />
      <bpmn:textAnnotation id="E_N1"><bpmn:text>Cada fila: nueva, duplicada de la fila N, ya en la bandeja o con error (no entra). La importación puede salir completa o parcial.</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="E_N2"><bpmn:text>Agrupar oficios no toca Sigrid: cambia cómo la plantilla enseña el desplegable. Un grupo con varios códigos en la obra llega como «oficio ambiguo» y se elige al revisar.</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="E_N3"><bpmn:text>Previsto: código de obra 626 → 0626 (F-063); ubicaciones por unidad en la plantilla (F-058); tabla con orden y filtros (F-057).</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="A_E_N1" associationDirection="None" sourceRef="E_N1" targetRef="E_Registrar" />
      <bpmn:association id="A_E_N2" associationDirection="None" sourceRef="E_N2" targetRef="E_Oficios" />
      <bpmn:association id="A_E_N3" associationDirection="None" sourceRef="E_N3" targetRef="E_Plantilla" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP_Revision" name="02 · Revisar la bandeja: editar, descartar, aprobar">
      <bpmn:incoming>F_Bandeja_Revision</bpmn:incoming>
      <bpmn:outgoing>F_Revision_Volcado</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_Revision"><bpmn:targetRef>DS_Bandeja</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:startEvent id="R_Start" name="Abre la bandeja de revisión de la obra">
        <bpmn:outgoing>R_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="R_MListar" name="">
        <bpmn:incoming>R_F1</bpmn:incoming>
        <bpmn:outgoing>R_F2</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R_Listar" name="Listar incidencias, resumen y motivos (relee el catálogo de Sigrid)">
        <bpmn:incoming>R_F2</bpmn:incoming>
        <bpmn:outgoing>R_F3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="R_GHace" name="¿Qué hace la persona?">
        <bpmn:incoming>R_F3</bpmn:incoming>
        <bpmn:outgoing>R_F4</bpmn:outgoing>
        <bpmn:outgoing>R_F5</bpmn:outgoing>
        <bpmn:outgoing>R_F6</bpmn:outgoing>
        <bpmn:outgoing>R_F7</bpmn:outgoing>
        <bpmn:outgoing>R_F8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R_Editar" name="Editar con el catálogo de hoy (lo que no está, marcado)">
        <bpmn:incoming>R_F4</bpmn:incoming>
        <bpmn:outgoing>R_F13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="R_Descartar" name="Descartar, con motivo opcional">
        <bpmn:incoming>R_F5</bpmn:incoming>
        <bpmn:outgoing>R_F14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="R_Recuperar" name="Recuperar una descartada">
        <bpmn:incoming>R_F6</bpmn:incoming>
        <bpmn:outgoing>R_F15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="R_Aprobar" name="Aprobar">
        <bpmn:incoming>R_F7</bpmn:incoming>
        <bpmn:outgoing>R_F9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="R_Termina" name="Terminar la revisión">
        <bpmn:incoming>R_F8</bpmn:incoming>
        <bpmn:outgoing>R_F20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="R_Comprobar" name="Comprobar contra Sigrid: unidad, ubicación, oficio, proveedor, duplicada">
        <bpmn:incoming>R_F9</bpmn:incoming>
        <bpmn:outgoing>R_F10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="R_GAprobable" name="¿Aprobable?">
        <bpmn:incoming>R_F10</bpmn:incoming>
        <bpmn:outgoing>R_F11</bpmn:outgoing>
        <bpmn:outgoing>R_F12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="R_EndNoAprob" name="No aprobable: enseña los motivos">
        <bpmn:incoming>R_F11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="R_MGuardar" name="">
        <bpmn:incoming>R_F12</bpmn:incoming>
        <bpmn:incoming>R_F13</bpmn:incoming>
        <bpmn:incoming>R_F14</bpmn:incoming>
        <bpmn:incoming>R_F15</bpmn:incoming>
        <bpmn:outgoing>R_F16</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="R_Guardar" name="Guardar la revisión con quién y cuándo">
        <bpmn:incoming>R_F16</bpmn:incoming>
        <bpmn:outgoing>R_F17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="R_GOtra" name="¿Otra persona la cambió antes?">
        <bpmn:incoming>R_F17</bpmn:incoming>
        <bpmn:outgoing>R_F18</bpmn:outgoing>
        <bpmn:outgoing>R_F19</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="R_EndOtra" name="Avisa y vuelve a cargar">
        <bpmn:incoming>R_F18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="R_EndBien" name="Guardada: la lista se pone al día">
        <bpmn:incoming>R_F19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="R_End" name="Aprobadas: candidatas al volcado">
        <bpmn:incoming>R_F20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="R_F1" sourceRef="R_Start" targetRef="R_MListar" />
      <bpmn:sequenceFlow id="R_F2" sourceRef="R_MListar" targetRef="R_Listar" />
      <bpmn:sequenceFlow id="R_F3" sourceRef="R_Listar" targetRef="R_GHace" />
      <bpmn:sequenceFlow id="R_F4" name="Edita" sourceRef="R_GHace" targetRef="R_Editar" />
      <bpmn:sequenceFlow id="R_F5" name="Descarta" sourceRef="R_GHace" targetRef="R_Descartar" />
      <bpmn:sequenceFlow id="R_F6" name="Recupera" sourceRef="R_GHace" targetRef="R_Recuperar" />
      <bpmn:sequenceFlow id="R_F7" name="Aprueba" sourceRef="R_GHace" targetRef="R_Aprobar" />
      <bpmn:sequenceFlow id="R_F8" name="Termina" sourceRef="R_GHace" targetRef="R_Termina" />
      <bpmn:sequenceFlow id="R_F9" sourceRef="R_Aprobar" targetRef="R_Comprobar" />
      <bpmn:sequenceFlow id="R_F10" sourceRef="R_Comprobar" targetRef="R_GAprobable" />
      <bpmn:sequenceFlow id="R_F11" name="No" sourceRef="R_GAprobable" targetRef="R_EndNoAprob" />
      <bpmn:sequenceFlow id="R_F12" name="Sí" sourceRef="R_GAprobable" targetRef="R_MGuardar" />
      <bpmn:sequenceFlow id="R_F13" sourceRef="R_Editar" targetRef="R_MGuardar" />
      <bpmn:sequenceFlow id="R_F14" sourceRef="R_Descartar" targetRef="R_MGuardar" />
      <bpmn:sequenceFlow id="R_F15" sourceRef="R_Recuperar" targetRef="R_MGuardar" />
      <bpmn:sequenceFlow id="R_F16" sourceRef="R_MGuardar" targetRef="R_Guardar" />
      <bpmn:sequenceFlow id="R_F17" sourceRef="R_Guardar" targetRef="R_GOtra" />
      <bpmn:sequenceFlow id="R_F18" name="Sí" sourceRef="R_GOtra" targetRef="R_EndOtra" />
      <bpmn:sequenceFlow id="R_F19" name="No" sourceRef="R_GOtra" targetRef="R_EndBien" />
      <bpmn:sequenceFlow id="R_F20" sourceRef="R_Termina" targetRef="R_End" />
      <bpmn:textAnnotation id="R_N1"><bpmn:text>Estados: nueva, editada, aprobada, descartada, volcada y en duda. Las volcadas y en duda se ven con su código de Sigrid, sin acciones (F-038).</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="R_N2"><bpmn:text>Motivos: unidad fuera de la obra, sin ubicación, ubicación fuera de la lista, sin oficio, oficio ambiguo o fuera de la obra, par fuera de la obra, proveedor ambiguo, duplicada.</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="R_N3"><bpmn:text>Previsto: ver también las reclamaciones que ya hay en Sigrid y los conflictos (F-064).</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="A_R_N1" associationDirection="None" sourceRef="R_N1" targetRef="R_Listar" />
      <bpmn:association id="A_R_N2" associationDirection="None" sourceRef="R_N2" targetRef="R_Comprobar" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP_Volcado" name="03 · Volcar a Sigrid lo aprobado">
      <bpmn:incoming>F_Revision_Volcado</bpmn:incoming>
      <bpmn:outgoing>F_Volcado_PTE</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DA_Volcado"><bpmn:sourceRef>DS_Bandeja</bpmn:sourceRef></bpmn:dataInputAssociation>
      <bpmn:startEvent id="V_Start" name="Abre el panel de volcado (previsto, F-040)">
        <bpmn:outgoing>V_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="V_Candidatas" name="Leer candidatas: aprobadas y en duda">
        <bpmn:incoming>V_F1</bpmn:incoming>
        <bpmn:outgoing>V_F2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="V_PideEnsayo" name="Pedir el ensayo">
        <bpmn:incoming>V_F2</bpmn:incoming>
        <bpmn:outgoing>V_F3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="V_Ensayo" name="Ensayo con Sigrid sin escribir; caduca a los 30 min">
        <bpmn:incoming>V_F3</bpmn:incoming>
        <bpmn:outgoing>V_F4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="V_GPrevistos" name="¿Hay partes previstos?">
        <bpmn:incoming>V_F4</bpmn:incoming>
        <bpmn:outgoing>V_F5</bpmn:outgoing>
        <bpmn:outgoing>V_F6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="V_EndNada" name="Nada que volcar">
        <bpmn:incoming>V_F5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="V_Confirmar" name="Confirmar el volcado (segundo clic con el número de partes)">
        <bpmn:incoming>V_F6</bpmn:incoming>
        <bpmn:outgoing>V_F7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="V_GVentana" name="¿Ventana del volcado abierta?">
        <bpmn:incoming>V_F7</bpmn:incoming>
        <bpmn:outgoing>V_F8</bpmn:outgoing>
        <bpmn:outgoing>V_F9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="V_EndCerrada" name="No se escribe nada (503)">
        <bpmn:incoming>V_F8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="V_GEnsayo" name="¿Ensayo válido: misma persona y menos de 30 min?">
        <bpmn:incoming>V_F9</bpmn:incoming>
        <bpmn:outgoing>V_F10</bpmn:outgoing>
        <bpmn:outgoing>V_F11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="V_EndEnsayo" name="Hay que ensayar otra vez (409)">
        <bpmn:incoming>V_F10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="V_Anotar" name="Anotar «enviado» antes de llamar">
        <bpmn:incoming>V_F11</bpmn:incoming>
        <bpmn:outgoing>V_F12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="V_Crear" name="Crear los partes en Sigrid (ref. PVI-, sin reintento)">
        <bpmn:incoming>V_F12</bpmn:incoming>
        <bpmn:outgoing>V_F13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="V_GResultado" name="Resultado de cada parte">
        <bpmn:incoming>V_F13</bpmn:incoming>
        <bpmn:outgoing>V_F14</bpmn:outgoing>
        <bpmn:outgoing>V_F15</bpmn:outgoing>
        <bpmn:outgoing>V_F16</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="V_Volcada" name="Marcar volcada con su código RS…">
        <bpmn:incoming>V_F14</bpmn:incoming>
        <bpmn:outgoing>V_F17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="V_EndVolcada" name="Parte en SAT">
        <bpmn:incoming>V_F17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="V_Rechazada" name="Sigue aprobada, con su motivo">
        <bpmn:incoming>V_F15</bpmn:incoming>
        <bpmn:outgoing>V_F18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="V_EndRechazada" name="Corregir y volver a volcar">
        <bpmn:incoming>V_F18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="V_Duda" name="Marcar en duda">
        <bpmn:incoming>V_F16</bpmn:incoming>
        <bpmn:outgoing>V_F19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="V_EndDuda" name="Reintentar: la referencia no duplica">
        <bpmn:incoming>V_F19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="V_F1" sourceRef="V_Start" targetRef="V_Candidatas" />
      <bpmn:sequenceFlow id="V_F2" sourceRef="V_Candidatas" targetRef="V_PideEnsayo" />
      <bpmn:sequenceFlow id="V_F3" sourceRef="V_PideEnsayo" targetRef="V_Ensayo" />
      <bpmn:sequenceFlow id="V_F4" sourceRef="V_Ensayo" targetRef="V_GPrevistos" />
      <bpmn:sequenceFlow id="V_F5" name="No" sourceRef="V_GPrevistos" targetRef="V_EndNada" />
      <bpmn:sequenceFlow id="V_F6" name="Sí" sourceRef="V_GPrevistos" targetRef="V_Confirmar" />
      <bpmn:sequenceFlow id="V_F7" sourceRef="V_Confirmar" targetRef="V_GVentana" />
      <bpmn:sequenceFlow id="V_F8" name="No" sourceRef="V_GVentana" targetRef="V_EndCerrada" />
      <bpmn:sequenceFlow id="V_F9" name="Sí" sourceRef="V_GVentana" targetRef="V_GEnsayo" />
      <bpmn:sequenceFlow id="V_F10" name="No" sourceRef="V_GEnsayo" targetRef="V_EndEnsayo" />
      <bpmn:sequenceFlow id="V_F11" name="Sí" sourceRef="V_GEnsayo" targetRef="V_Anotar" />
      <bpmn:sequenceFlow id="V_F12" sourceRef="V_Anotar" targetRef="V_Crear" />
      <bpmn:sequenceFlow id="V_F13" sourceRef="V_Crear" targetRef="V_GResultado" />
      <bpmn:sequenceFlow id="V_F14" name="Creado o ya existía" sourceRef="V_GResultado" targetRef="V_Volcada" />
      <bpmn:sequenceFlow id="V_F17" sourceRef="V_Volcada" targetRef="V_EndVolcada" />
      <bpmn:sequenceFlow id="V_F18" sourceRef="V_Rechazada" targetRef="V_EndRechazada" />
      <bpmn:sequenceFlow id="V_F19" sourceRef="V_Duda" targetRef="V_EndDuda" />
      <bpmn:sequenceFlow id="V_F15" name="Rechazado" sourceRef="V_GResultado" targetRef="V_Rechazada" />
      <bpmn:sequenceFlow id="V_F16" name="Sin respuesta" sourceRef="V_GResultado" targetRef="V_Duda" />
      <bpmn:textAnnotation id="V_N1"><bpmn:text>La ventana VOLCADO_HABILITADO se abre para cada volcado con infra/27_ventana_volcado.ps1 y cada despliegue la cierra. El ensayo funciona con ella cerrada.</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="V_N2"><bpmn:text>Posventa pasa el parte a PTE a mano en Sigrid: es lo que avisa al industrial.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="A_V_N1" associationDirection="None" sourceRef="V_N1" targetRef="V_GVentana" />
      <bpmn:association id="A_V_N2" associationDirection="None" sourceRef="V_N2" targetRef="V_Volcada" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP_Partes" name="05 · 06 · Partes firmados: archivar y cerrar en Sigrid">
      <bpmn:incoming>F_Remesa_Partes</bpmn:incoming>
      <bpmn:outgoing>F_Partes_Coste</bpmn:outgoing>
      <bpmn:startEvent id="P_Start" name="Llega la remesa escaneada">
        <bpmn:outgoing>P_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:startEvent id="P_StartBuzon" name="Remesa desde un buzón (previsto, F-011)">
        <bpmn:outgoing>P_F2</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="P_MInicio" name="">
        <bpmn:incoming>P_F1</bpmn:incoming>
        <bpmn:incoming>P_F2</bpmn:incoming>
        <bpmn:outgoing>P_F3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P_Subir" name="Subir la remesa (PDF, ZIP o carpeta)">
        <bpmn:incoming>P_F3</bpmn:incoming>
        <bpmn:outgoing>P_F4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="P_Trocear" name="Trocear en partes por el pie «Página N»">
        <bpmn:incoming>P_F4</bpmn:incoming>
        <bpmn:outgoing>P_F5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P_Leer" name="Leer cada parte con IA: 9 campos y la firma (3 a la vez)">
        <bpmn:incoming>P_F5</bpmn:incoming>
        <bpmn:outgoing>P_F6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P_Validar" name="Validar y clasificar el parte">
        <bpmn:incoming>P_F6</bpmn:incoming>
        <bpmn:outgoing>P_F7</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="P_GDestino" name="¿Cómo sale?">
        <bpmn:incoming>P_F7</bpmn:incoming>
        <bpmn:outgoing>P_F8</bpmn:outgoing>
        <bpmn:outgoing>P_F9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P_Revisar" name="Revisar con su PDF, corregir y revalidar">
        <bpmn:incoming>P_F8</bpmn:incoming>
        <bpmn:outgoing>P_F10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="P_GDecide" name="¿Aprobar o rechazar?">
        <bpmn:incoming>P_F10</bpmn:incoming>
        <bpmn:outgoing>P_F11</bpmn:outgoing>
        <bpmn:outgoing>P_F12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="P_EndRechazo" name="Parte rechazado, con su motivo">
        <bpmn:incoming>P_F11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="P_MAprobado" name="">
        <bpmn:incoming>P_F9</bpmn:incoming>
        <bpmn:incoming>P_F12</bpmn:incoming>
        <bpmn:outgoing>P_F13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P_ArchivarCerrar" name="Archivar y cerrar los aptos (segundo clic)">
        <bpmn:incoming>P_F13</bpmn:incoming>
        <bpmn:outgoing>P_F14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="P_Archivar" name="Archivar en SharePoint: obra / INCIDENCIAS / unidad / FIRMADOS">
        <bpmn:incoming>P_F14</bpmn:incoming>
        <bpmn:outgoing>P_F15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="P_GArchivo" name="¿Archivado?">
        <bpmn:incoming>P_F15</bpmn:incoming>
        <bpmn:outgoing>P_F16</bpmn:outgoing>
        <bpmn:outgoing>P_F17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="P_EndArchivo" name="Carpeta dudosa o ventana cerrada: la tanda se detiene">
        <bpmn:incoming>P_F16</bpmn:incoming>
        <bpmn:errorEventDefinition id="P_EndArchivo_Err" errorRef="Error_Archivo" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="P_GYaCerrada" name="¿La reclamación ya estaba cerrada?">
        <bpmn:incoming>P_F17</bpmn:incoming>
        <bpmn:outgoing>P_F18</bpmn:outgoing>
        <bpmn:outgoing>P_F19</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="P_EndYa" name="No se toca">
        <bpmn:incoming>P_F18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="P_Adjuntar" name="Adjuntar el PDF a Sigrid como «PARTE FIRMADO»">
        <bpmn:incoming>P_F19</bpmn:incoming>
        <bpmn:outgoing>P_F20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="P_MCerrar" name="">
        <bpmn:incoming>P_F20</bpmn:incoming>
        <bpmn:incoming>P_F25</bpmn:incoming>
        <bpmn:outgoing>P_F21</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="P_Cerrar" name="Cerrar la reclamación en Sigrid (CER)">
        <bpmn:incoming>P_F21</bpmn:incoming>
        <bpmn:outgoing>P_F22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="P_GCerrada" name="¿Cerrada?">
        <bpmn:incoming>P_F22</bpmn:incoming>
        <bpmn:outgoing>P_F23</bpmn:outgoing>
        <bpmn:outgoing>P_F24</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="P_Reintentar" name="Reintentar el cierre">
        <bpmn:incoming>P_F24</bpmn:incoming>
        <bpmn:outgoing>P_F25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="P_End" name="Incidencia cerrada (CER)">
        <bpmn:incoming>P_F23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P_F1" sourceRef="P_Start" targetRef="P_MInicio" />
      <bpmn:sequenceFlow id="P_F2" sourceRef="P_StartBuzon" targetRef="P_MInicio" />
      <bpmn:sequenceFlow id="P_F3" sourceRef="P_MInicio" targetRef="P_Subir" />
      <bpmn:sequenceFlow id="P_F4" sourceRef="P_Subir" targetRef="P_Trocear" />
      <bpmn:sequenceFlow id="P_F5" sourceRef="P_Trocear" targetRef="P_Leer" />
      <bpmn:sequenceFlow id="P_F6" sourceRef="P_Leer" targetRef="P_Validar" />
      <bpmn:sequenceFlow id="P_F7" sourceRef="P_Validar" targetRef="P_GDestino" />
      <bpmn:sequenceFlow id="P_F8" name="Observaciones, ilegible o firma dudosa" sourceRef="P_GDestino" targetRef="P_Revisar" />
      <bpmn:sequenceFlow id="P_F9" name="Apto: nace aprobado" sourceRef="P_GDestino" targetRef="P_MAprobado" />
      <bpmn:sequenceFlow id="P_F10" sourceRef="P_Revisar" targetRef="P_GDecide" />
      <bpmn:sequenceFlow id="P_F11" name="Rechazar" sourceRef="P_GDecide" targetRef="P_EndRechazo" />
      <bpmn:sequenceFlow id="P_F12" name="Aprobar" sourceRef="P_GDecide" targetRef="P_MAprobado" />
      <bpmn:sequenceFlow id="P_F13" sourceRef="P_MAprobado" targetRef="P_ArchivarCerrar" />
      <bpmn:sequenceFlow id="P_F14" sourceRef="P_ArchivarCerrar" targetRef="P_Archivar" />
      <bpmn:sequenceFlow id="P_F15" sourceRef="P_Archivar" targetRef="P_GArchivo" />
      <bpmn:sequenceFlow id="P_F16" name="No" sourceRef="P_GArchivo" targetRef="P_EndArchivo" />
      <bpmn:sequenceFlow id="P_F17" name="Sí" sourceRef="P_GArchivo" targetRef="P_GYaCerrada" />
      <bpmn:sequenceFlow id="P_F18" name="Sí" sourceRef="P_GYaCerrada" targetRef="P_EndYa" />
      <bpmn:sequenceFlow id="P_F19" name="No" sourceRef="P_GYaCerrada" targetRef="P_Adjuntar" />
      <bpmn:sequenceFlow id="P_F20" sourceRef="P_Adjuntar" targetRef="P_MCerrar" />
      <bpmn:sequenceFlow id="P_F21" sourceRef="P_MCerrar" targetRef="P_Cerrar" />
      <bpmn:sequenceFlow id="P_F22" sourceRef="P_Cerrar" targetRef="P_GCerrada" />
      <bpmn:sequenceFlow id="P_F23" name="Sí" sourceRef="P_GCerrada" targetRef="P_End" />
      <bpmn:sequenceFlow id="P_F24" name="No" sourceRef="P_GCerrada" targetRef="P_Reintentar" />
      <bpmn:sequenceFlow id="P_F25" sourceRef="P_Reintentar" targetRef="P_MCerrar" />
      <bpmn:textAnnotation id="P_N1"><bpmn:text>Estados del parte: pendiente, aprobado, rechazado y cerrado. No son los de Sigrid (SAT, PTE, TER, CER).</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="P_N2"><bpmn:text>Ventanas: archivar usa ARCHIVO_HABILITADO; adjuntar y cerrar, CIERRE_HABILITADO. Con la de cierre cerrada se archiva igual, pero no se toca Sigrid.</bpmn:text></bpmn:textAnnotation>
      <bpmn:textAnnotation id="P_N3"><bpmn:text>Previsto: un parte sin firma deja la incidencia en TER (F-045).</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="A_P_N1" associationDirection="None" sourceRef="P_N1" targetRef="P_Validar" />
      <bpmn:association id="A_P_N2" associationDirection="None" sourceRef="P_N2" targetRef="P_Archivar" />
      <bpmn:association id="A_P_N3" associationDirection="None" sourceRef="P_N3" targetRef="P_Adjuntar" />
    </bpmn:subProcess>
  </bpmn:process>

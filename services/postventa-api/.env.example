# services/postventa-api/.env.example
# Copia este fichero a .env y rellena los valores. El .env NUNCA se versiona.
ENTORNO=local
NIVEL_LOG=INFO

# --- Extracción con IA (F-003) ---
# La credencial es un SECRETO: aquí van placeholders, nunca valores reales.
# En Azure viaja por Key Vault; en local, solo en tu .env.
IA_PROVIDER=gemini
GEMINI_API_KEY=pon-aqui-tu-clave
GEMINI_MODEL=gemini-3.7-flash
IA_TIMEOUT_S=120
IA_REINTENTOS=3
PROMPT_KEY=parte_posventa_es
# Prompt que clasifica la firma del cliente (F-004). Va aparte del de
# extracción: son dos lecturas independientes del mismo parte.
PROMPT_KEY_FIRMA=firma_parte_es
PROMPTS_YAML_PATH=config/prompts.yaml

# --- Persistencia en PostgreSQL (F-005) ---
# Servidor COMPARTIDO con albaranes y compañía: aquí van solo los NOMBRES de
# las variables, jamás un valor real. La contraseña es un SECRETO: en Azure
# viaja por Key Vault; en local, solo en tu .env, que no se versiona.
# La base y el rol los crea el humano una vez (infra/crear_base_postventa.ps1):
# la aplicación NUNCA los crea.
PG_HOST=pon-aqui-el-host
PG_PORT=5432
PG_DB=postventa
PG_USER=pon-aqui-el-usuario
PG_PASSWORD=pon-aqui-la-contrasena
PG_SCHEMA=postventa
PG_SSLMODE=require
PG_MAX_CONEXIONES=4
PG_STATEMENT_TIMEOUT_S=30
PG_LOCK_TIMEOUT_S=5
PG_IDLE_IN_TRANSACTION_TIMEOUT_S=60

# services/postventa-api/.env.example
# Copia este fichero a .env y rellena los valores. El .env NUNCA se versiona.
ENTORNO=local
NIVEL_LOG=INFO

# --- Extracción con IA (F-003) ---
# La credencial es un SECRETO: aquí van placeholders, nunca valores reales.
# En Azure viaja por Key Vault; en local, solo en tu .env.
IA_PROVIDER=gemini
GEMINI_API_KEY=pon-aqui-tu-clave
GEMINI_MODEL=gemini-3.7-flash
IA_TIMEOUT_S=120
IA_REINTENTOS=3
PROMPT_KEY=parte_posventa_es
# Prompt que clasifica la firma del cliente (F-004). Va aparte del de
# extracción: son dos lecturas independientes del mismo parte.
PROMPT_KEY_FIRMA=firma_parte_es
PROMPTS_YAML_PATH=config/prompts.yaml

# --- Persistencia en PostgreSQL (F-005) ---
# Servidor COMPARTIDO con albaranes y compañía: aquí van solo los NOMBRES de
# las variables, jamás un valor real. La contraseña es un SECRETO: en Azure
# viaja por Key Vault; en local, solo en tu .env, que no se versiona.
# La base y el rol los crea el humano una vez (infra/crear_base_postventa.ps1):
# la aplicación NUNCA los crea.
PG_HOST=pon-aqui-el-host
PG_PORT=5432
PG_DB=postventa
PG_USER=pon-aqui-el-usuario
PG_PASSWORD=pon-aqui-la-contrasena
PG_SCHEMA=postventa
PG_SSLMODE=require
PG_MAX_CONEXIONES=4
PG_STATEMENT_TIMEOUT_S=30
PG_LOCK_TIMEOUT_S=5
PG_IDLE_IN_TRANSACTION_TIMEOUT_S=60

# --- Archivo en SharePoint por Microsoft Graph (F-006) ---
# Aquí van solo PLACEHOLDERS: ni el sitio, ni la biblioteca, ni el tenant, ni
# la aplicación, ni el secreto entran en el repositorio. Ningún identificador
# real se escribe en ningún fichero versionado.
#
# ARCHIVO_HABILITADO es el interruptor maestro y va APAGADO por defecto: con
# él en falso no se sube nada, pase lo que pase. Y aunque se encienda, subir
# solo se permite con ENTORNO=dev o pro: desde un puesto de trabajo está
# prohibido y el propio código lo impide.
ARCHIVO_HABILITADO=false
SHAREPOINT_SITE_ID=pon-aqui-el-sitio
SHAREPOINT_DRIVE_ID=pon-aqui-la-biblioteca
SHAREPOINT_CARPETA_BASE=Postventa
GRAPH_TENANT_ID=pon-aqui-el-tenant
GRAPH_CLIENT_ID=pon-aqui-la-aplicacion
GRAPH_CLIENT_SECRET=pon-aqui-el-secreto
GRAPH_TIMEOUT_S=60
GRAPH_REINTENTOS=3

# --- El destino del archivo: la estructura de Posventa (F-013) ---
# SHAREPOINT_ESTRUCTURA elige cómo se compone la carpeta: `por_obra` (F-006,
# <base>/<código de obra>: lo de siempre, y el valor por defecto) o `posventa`
# (F-013: la estructura que ya usa Posventa, <obra>/PARTES INCIDENCIAS/
# <unidad>/PARTES FIRMADOS, casando con las carpetas que existen y creando
# las que falten solo si no hay ninguna parecida). Con `posventa`,
# SHAREPOINT_CARPETA_BASE vacía es la raíz de la biblioteca; con `por_obra`,
# vacía es un error de configuración. Con `posventa`, archivar lee además
# Sigrid (dos lecturas por parte), así que hacen falta las SIGRID_* de abajo.
# SHAREPOINT_CREAR_CARPETAS=false es el freno: no se crea ninguna carpeta y
# falta de carpeta = 409. Da igual en un puesto de trabajo: fuera de ENTORNO
# dev o pro no se lista ni se sube nada.
SHAREPOINT_ESTRUCTURA=por_obra
SHAREPOINT_CARPETA_INCIDENCIAS=PARTES INCIDENCIAS
SHAREPOINT_CARPETA_FIRMADOS=PARTES FIRMADOS
SHAREPOINT_CARPETA_FIRMADOS_ALTERNATIVA=PARTES FIRMADO
SHAREPOINT_CREAR_CARPETAS=true

# --- Cierre de la incidencia en Sigrid (F-009) ---
# ESTO ESCRIBE EN EL ERP DE PRODUCCIÓN. Aquí van solo PLACEHOLDERS: ni la URL
# de la pasarela, ni la clave de función, ni el nombre de la base entran en el
# repositorio.
#
# CIERRE_HABILITADO es el interruptor maestro y va APAGADO por defecto: con él
# en falso no se cierra nada, pase lo que pase. Y aunque se encienda, cerrar
# solo se permite con ENTORNO=dev o pro: desde un puesto de trabajo está
# prohibido y el propio código lo impide, en la fábrica y en el adaptador.
CIERRE_HABILITADO=false
SIGRID_API_BASE_URL=pon-aqui-la-url-de-la-pasarela
SIGRID_API_KEY=pon-aqui-la-clave
SIGRID_BASE_DATOS=pon-aqui-la-base-de-negocio
SIGRID_TIMEOUT_S=35
SIGRID_REINTENTOS=3
SIGRID_TIP_RECLAMACION=708
SIGRID_ZONA_HORARIA=Europe/Madrid

# --- El parte como gráfico de la incidencia (F-012) ---
# No hay interruptor nuevo: el gráfico y el cierre son la MISMA ventana de
# escritura, CIERRE_HABILITADO, porque son el mismo sistema, el mismo dueño y
# la misma decisión (design.md D-B). Estas dos son parámetros, no secretos.
#
# SIGRID_GRATIPIDE_PARTE es la clase de gráfico de Posventa (auxgra.ide 35 =
# PV002 «POSTVENTA:Fotos Reparaciones»), configurable porque es configuración
# de la instalación y no una constante del código.
# GRAFICO_MAX_BYTES es el tope propio, comprobado ANTES de llamar a la
# pasarela. NO debe superar el de la pasarela (SIGRID_DOCUMENT_MAX_BYTES, 10
# MB): subirlo aquí solo compra un rechazo más tardío.
SIGRID_GRATIPIDE_PARTE=35
GRAFICO_MAX_BYTES=10485760
